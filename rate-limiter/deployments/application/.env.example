# Application
APP_BIND_IP=192.168.1.100
APP_PORT=8000

# PostgreSQL
POSTGRES_DB=school
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# Application database connection
DATABASE_URL=postgresql+psycopg://admin:password@postgres:5432/school

# Exporters
POSTGRES_EXPORTER_BIND_IP=192.168.1.100
POSTGRES_EXPORTER_PORT=9187
NODE_EXPORTER_BIND_IP=192.168.1.100
NODE_EXPORTER_PORT=9100


# PostgreSQL exporter connection
POSTGRES_EXPORTER_URI=postgres:5432/school?sslmode=disable
POSTGRES_EXPORTER_USER=admin
POSTGRES_EXPORTER_PASSWORD=password
POSTGRES_EXPORTER_DSN=postgresql://exporter_user:exporter_password@postgres:5432/school?sslmode=disable